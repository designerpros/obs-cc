# ============================================================================
# BBB POST-STREAM EXTRACTION PIPELINE - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE (PostgreSQL with pgvector)
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stream_extraction
POSTGRES_USER=pipeline_worker
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# REDIS (Job Queue)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# LLM API KEYS
# ============================================================================

# Anthropic (Claude) - Required for topic segmentation and scoring
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# OpenAI (GPT-4o) - Required for LLM consensus scoring
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-CHANGE_ME

# Grok (xAI) - Required for LLM cascade cheap screening
# Get from: https://x.ai/api
GROK_API_KEY=xai-CHANGE_ME

# Perplexity - Required for LLM consensus scoring
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-CHANGE_ME

# ============================================================================
# TRANSCRIPTION
# ============================================================================

# AssemblyAI - Backup transcription if Whisper fails
# Get from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=CHANGE_ME

# Hugging Face - Required for pyannote speaker diarization
# Get from: https://huggingface.co/settings/tokens
# NOTE: Must accept pyannote terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_CHANGE_ME

# ============================================================================
# POSTING (Late API)
# ============================================================================

# Late API - Required for multi-platform posting
# Get from: https://www.late.dev/
LATE_API_KEY=CHANGE_ME
LATE_API_ENDPOINT=https://api.late.dev

# ============================================================================
# S3 ARCHIVAL
# ============================================================================

# AWS S3 credentials
S3_ENDPOINT=s3.amazonaws.com
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_REGION=us-east-1

# S3 bucket names
S3_BUCKET_SOURCES=bbb-stream-clean-sources
S3_BUCKET_EXTRACTIONS=bbb-stream-extractions

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Discord bot for notifications and commands
# Create bot at: https://discord.com/developers/applications
# Enable MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME

# Telegram bot (optional, mirrors Discord)
# Create bot via @BotFather
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# ============================================================================
# INGESTION
# ============================================================================

# Path to watch for new stream uploads (on local machine)
WATCH_PATH=C:\\stream_recordings\\

# Webhook auth token (for manual triggers)
WEBHOOK_AUTH_TOKEN=CHANGE_ME_RANDOM_TOKEN_HERE

# ============================================================================
# ADDITIONAL APIS (Optional)
# ============================================================================

# Pixabay - For royalty-free BGM
# Get from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=CHANGE_ME

# YouTube Data API - For thumbnail A/B testing (Phase 5)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=CHANGE_ME
YOUTUBE_CLIENT_SECRET=CHANGE_ME

# ============================================================================
# TAILSCALE (Multi-node networking)
# ============================================================================

# Tailscale node hostnames (update with your actual hostnames)
NODE_A_HOSTNAME=nodeA.tail-xxxxx.ts.net
NODE_B_HOSTNAME=nodeB.tail-xxxxx.ts.net
NODE_C_HOSTNAME=nodeC.tail-xxxxx.ts.net
NODE_D_HOSTNAME=nodeD.tail-xxxxx.ts.net

# ============================================================================
# DEVELOPMENT
# ============================================================================

# Set to 'true' to enable debug logging
DEBUG=false

# Configuration file path
PIPELINE_CONFIG_PATH=/app/config/pipeline.yaml

# Working directory for pipeline
WORK_DIR=/mnt/pipeline/work

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
