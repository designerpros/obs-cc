# ============================================================================
# BBB POST-STREAM EXTRACTION PIPELINE - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE (PostgreSQL with pgvector)
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stream_extraction
POSTGRES_USER=pipeline_worker
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# REDIS (Job Queue)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================================================
# LLM API KEYS
# ============================================================================

# Anthropic (Claude) - Required for topic segmentation and scoring
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# OpenAI (GPT-4o) - Required for LLM consensus scoring
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-CHANGE_ME

# Grok (xAI) - Required for LLM cascade cheap screening
# Get from: https://x.ai/api
GROK_API_KEY=xai-CHANGE_ME

# Perplexity - Required for LLM consensus scoring
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-CHANGE_ME

# ============================================================================
# TRANSCRIPTION
# ============================================================================

# AssemblyAI - Backup transcription if Whisper fails
# Get from: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=CHANGE_ME

# Hugging Face - Required for pyannote speaker diarization
# Get from: https://huggingface.co/settings/tokens
# NOTE: Must accept pyannote terms at https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_CHANGE_ME

# ============================================================================
# POSTING (Late API)
# ============================================================================

# Late API - Required for multi-platform posting
# Get from: https://www.late.dev/
LATE_API_KEY=CHANGE_ME
LATE_API_ENDPOINT=https://api.late.dev

# ============================================================================
# S3 ARCHIVAL
# ============================================================================

# AWS S3 credentials (use IAM user with S3 permissions)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# Legacy names (for compatibility)
S3_ENDPOINT=s3.amazonaws.com
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_REGION=us-east-1

# S3 bucket names
S3_BUCKET_SOURCES=bbb-stream-clean-sources
S3_BUCKET_EXTRACTIONS=bbb-stream-extractions
S3_BUCKET=bbb-pipeline-recordings

# ============================================================================
# NOTIFICATIONS & ALERTS
# ============================================================================

# Discord bot for notifications and commands
# Create bot at: https://discord.com/developers/applications
# Enable MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME

# Telegram bot (optional, mirrors Discord)
# Create bot via @BotFather
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# PagerDuty (for critical production alerts)
# Get from: https://support.pagerduty.com/docs/services-and-integrations
PAGERDUTY_INTEGRATION_KEY=CHANGE_ME

# ============================================================================
# INGESTION
# ============================================================================

# Path to watch for new stream uploads
# Linux/Mac: /mnt/recordings/
# Windows: C:\\stream_recordings\\
WATCH_PATH=/mnt/recordings/

# Webhook auth token (for manual triggers)
WEBHOOK_AUTH_TOKEN=CHANGE_ME_RANDOM_TOKEN_HERE

# ============================================================================
# ADDITIONAL APIS (Optional)
# ============================================================================

# Pixabay - For royalty-free B-roll stock media
# Get from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=CHANGE_ME

# ComfyUI - For AI-generated B-roll
# ComfyUI server endpoint (if running separately)
COMFYUI_URL=http://comfyui:8188
COMFYUI_API_KEY=CHANGE_ME

# YouTube Data API - For thumbnail A/B testing (Phase 5)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=CHANGE_ME
YOUTUBE_CLIENT_SECRET=CHANGE_ME

# ============================================================================
# TAILSCALE (Multi-node networking)
# ============================================================================

# Tailscale node hostnames (update with your actual hostnames)
NODE_A_HOSTNAME=nodeA.tail-xxxxx.ts.net
NODE_B_HOSTNAME=nodeB.tail-xxxxx.ts.net
NODE_C_HOSTNAME=nodeC.tail-xxxxx.ts.net
NODE_D_HOSTNAME=nodeD.tail-xxxxx.ts.net

# ============================================================================
# DEVELOPMENT & SERVICE
# ============================================================================

# Service name (used for health checks and logging)
SERVICE_NAME=pipeline

# Set to 'true' to enable debug logging
DEBUG=false

# Configuration file path
PIPELINE_CONFIG_PATH=/app/config/pipeline.yaml

# Working directory for pipeline
WORK_DIR=/mnt/pipeline/work
WORKING_DIR=/workspace

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Python unbuffered output
PYTHONUNBUFFERED=1

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus metrics port
PROMETHEUS_PORT=9090

# Grafana configuration
GRAFANA_API_KEY=CHANGE_ME
GRAFANA_URL=http://grafana:3000

# Sentry error tracking (optional)
# Get from: https://sentry.io/
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# PRODUCTION HARDENING
# ============================================================================

# SSL/TLS Configuration
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/pipeline.crt
SSL_KEY_PATH=/etc/ssl/private/pipeline.key
TLS_ENABLED=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Circuit breaker settings
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Alert manager settings
ALERTS_ENABLED=true
ALERTS_COOLDOWN_SECONDS=300
ALERTS_MIN_SEVERITY_DISCORD=warning
ALERTS_MIN_SEVERITY_TELEGRAM=error
ALERTS_MIN_SEVERITY_PAGERDUTY=critical

# Disaster recovery settings
DISASTER_RECOVERY_ENABLED=true
DISASTER_RECOVERY_BACKUP_INTERVAL_HOURS=24
DISASTER_RECOVERY_RETENTION_DAYS=30
DISASTER_RECOVERY_BACKUP_PATH=/backups
DISASTER_RECOVERY_S3_BUCKET=bbb-pipeline-backups

# ============================================================================
# MODEL PATHS
# ============================================================================

# Whisper model path
WHISPER_MODEL_PATH=/models/faster-whisper-large-v3

# Pyannote model path
PYANNOTE_MODEL_PATH=/models/pyannote-speaker-diarization-3.1

# Sentence transformer for embeddings
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
