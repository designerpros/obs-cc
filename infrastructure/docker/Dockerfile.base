# Base image for all pipeline workers
# Contains common dependencies for Python, CUDA, FFmpeg

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

LABEL maintainer="stream-extraction-pipeline"
LABEL description="Base image for post-stream extraction pipeline"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda

# Install system dependencies
RUN apt-get update && apt-get install -y \
    # Python
    python3.11 \
    python3.11-dev \
    python3-pip \
    # FFmpeg with NVIDIA support
    ffmpeg \
    # Audio processing
    libsndfile1 \
    libsndfile1-dev \
    portaudio19-dev \
    # Image processing
    libgl1-mesa-glx \
    libglib2.0-0 \
    # Video codec libraries
    libx264-dev \
    libx265-dev \
    libvpx-dev \
    libfdk-aac-dev \
    libmp3lame-dev \
    libopus-dev \
    # System utilities
    git \
    wget \
    curl \
    unzip \
    nano \
    htop \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3.11 -m pip install --upgrade pip setuptools wheel

# Install core Python packages
RUN pip install --no-cache-dir \
    # Web frameworks
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    # Database
    psycopg2-binary==2.9.9 \
    sqlalchemy==2.0.23 \
    alembic==1.13.0 \
    asyncpg==0.29.0 \
    # Redis
    redis==5.0.1 \
    aioredis==2.0.1 \
    # Job queue
    celery==5.3.4 \
    # AWS S3
    boto3==1.34.10 \
    # HTTP clients
    httpx==0.25.2 \
    aiohttp==3.9.1 \
    # Data processing
    numpy==1.26.2 \
    pandas==2.1.4 \
    # Utilities
    python-dotenv==1.0.0 \
    pydantic==2.5.2 \
    pyyaml==6.0.1 \
    tenacity==8.2.3 \
    # Monitoring
    prometheus-client==0.19.0 \
    # Logging
    loguru==0.7.2

# Create app directory
WORKDIR /app

# Create common directories
RUN mkdir -p /app/common /app/logs /mnt/pipeline

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH

CMD ["/bin/bash"]
