# Ingestion Worker
# Handles file watching and webhook triggers for new streams

FROM stream-pipeline-base:latest

LABEL description="Ingestion worker for stream file watching and validation"

# Install ingestion-specific dependencies
RUN pip install --no-cache-dir \
    # File watching
    watchdog==3.0.0 \
    # Video file handling
    pymediainfo==6.1.0 \
    # File validation
    python-magic==0.4.27 \
    # Webhook server
    fastapi==0.104.1

# Copy common utilities
COPY pipeline/common /app/common

# Copy ingestion module
COPY pipeline/ingestion /app/ingestion

# Set working directory
WORKDIR /app/ingestion

# Expose webhook port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run ingestion worker
CMD ["python3", "-m", "ingestion.main"]
